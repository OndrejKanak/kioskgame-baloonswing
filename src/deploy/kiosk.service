# systemd UŽIVATELSKÁ služba pro autostart kiosku.
# Umístění: ~/.config/systemd/user/kiosk.service
#
# Instalace (jako uživatel s automatickým přihlášením do desktopu):
#   cd ~/kioskgame-baloonswing
#   mkdir -p ~/.config/systemd/user
#   # zkopíruje službu a rovnou do ní dosadí správnou cestu k projektu:
#   sed "s|^ExecStart=.*|ExecStart=$PWD/src/deploy/start-kiosk.sh|" \
#       src/deploy/kiosk.service > ~/.config/systemd/user/kiosk.service
#   systemctl --user daemon-reload
#   systemctl --user reenable kiosk.service
#   sudo loginctl enable-linger $USER    # ať se spustí hned po bootu
#
# Ovládání (vždy BEZ sudo a s --user):
#   systemctl --user restart kiosk       # restart
#   systemctl --user stop kiosk          # zastavit (třeba kvůli ladění)
#   journalctl --user -u kiosk -f        # živý log
#
# Proč default.target a ne graphical-session.target: na Raspberry Pi OS se
# grafická relace nespouští přes systemd, takže na graphical-session.target
# se nemusí nikdy dojít a služba by se tiše nespustila. Na grafickou relaci
# (Wayland) si proto počká sám start-kiosk.sh.

[Unit]
Description=Houpadlo kiosek (backend + Chromium)
# Nikdy to nevzdávej – kiosk se má obnovovat donekonečna,
# i kdyby několikrát po sobě spadl.
StartLimitIntervalSec=0

[Service]
Type=simple
# Cestu dosadí instalační příkaz výše (sed):
ExecStart=/home/pi/kioskgame-baloonswing/src/deploy/start-kiosk.sh
# always = i po běžném zavření Chromia (on-failure by ho nespustil znovu)
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
